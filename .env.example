# Transaction Pooler (porta 6543) — usado pela aplicação em runtime.
# Precisa de "?pgbouncer=true" no final, senão o Prisma tenta usar prepared
# statements que o pooler em modo transaction não suporta (causa erros
# aleatórios tipo "prepared statement already exists").
DATABASE_URL=
# Direct Connection (porta 5432) — usado só por `prisma migrate`/`db push`
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Settings > API > service_role secret key. Só no servidor — usada pra criar
# o bucket "avatars" e subir fotos de perfil. Nunca exponha no client.
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER="gemini"
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ENCRYPTION_KEY=
RESEND_API_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
