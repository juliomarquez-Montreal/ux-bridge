generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PermissionLevel {
  ADMIN
  USER
}

enum Funcao {
  PO
  UX
  GERENTE_PROJETOS
  OUTROS
}

enum TranscriptionStatus {
  UPLOADED
  EXTRACTED
  PENDING_PO_APPROVAL
  APPROVED
  PENDING_UX_APPROVAL
  DELIVERED
  REJECTED
}

enum ArtifactType {
  BDD
  PBI
}

enum ApprovalDecision {
  APPROVE
  REJECT
  CORRECT
}

// Hierarquia da NOVA (Fase N1): Universo (organização/cliente) > Galáxia
// (squad/área) > Estrela (categoria de trabalho) > Planeta (tarefa/artefato
// específico). UNIVERSO e GALAXIA só ADMIN cria; ESTRELA e PLANETA qualquer
// usuário autenticado cria (regra aplicada na Fase N2 — aqui só o schema).
enum ContextNodeType {
  UNIVERSO
  GALAXIA
  ESTRELA
  PLANETA
}

model User {
  id              String             @id @default(cuid())
  name            String
  email           String             @unique
  passwordHash    String?
  avatarUrl       String?
  permissionLevel PermissionLevel    @default(USER)
  funcao          Funcao             @default(OUTROS)
  // Galáxia selecionada no momento no seletor do header — só afeta o que a
  // UI mostra por padrão, não é fonte de permissão (isso é galaxyAccess,
  // abaixo). ADMIN não precisa de nenhum dos dois pra ter acesso total.
  currentGalaxyId String?
  currentGalaxy   ContextNode?       @relation("UserCurrentGalaxy", fields: [currentGalaxyId], references: [id])
  // Galáxias às quais este usuário (não-ADMIN) tem acesso pra criar/editar
  // Estrela e Planeta — substitui o antigo contextNodeId (uma única Galáxia
  // fixa) por N:N (Fase N7).
  galaxyAccess    UserGalaxyAccess[]
  createdAt       DateTime           @default(now())
  // Bridges onde este usuário é o PO ou o UX responsável (Wireframe-1a) —
  // ver Bridge.poUserId/uxUserId abaixo.
  bridgesAsPO     Bridge[]           @relation("BridgePO")
  bridgesAsUX     Bridge[]           @relation("BridgeUX")
}

// Acesso de um usuário a uma Galáxia (N:N) — ver lib/nova/permissions.ts.
// ADMIN não precisa de registro aqui (acesso total já é implícito).
model UserGalaxyAccess {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  galaxyId  String
  galaxy    ContextNode @relation(fields: [galaxyId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([userId, galaxyId])
}

// Bridge-1 + Bridge-3a + Wireframe-1a: fluxo de criação de um Bridge
// (material bruto -> BDD/PBI aprovado pelo PO -> Wireframe editado/aprovado
// pelo PO -> avaliação do UX). A etapa de "Sketch" (Bridge-3a/3b) foi
// substituída pelo editor de Wireframe profissional completo — ver
// lib/bridges/generate.ts e components/WireframeEditor.tsx. O fluxo de
// aprovação do UX e envio ao Figma vem na Wireframe-2 (ainda não
// implementado — o Bridge fica parado em AGUARDANDO_APROVACAO_UX).
model Bridge {
  id                  String      @id @default(cuid())
  planetContextNodeId String
  planet              ContextNode @relation(fields: [planetContextNodeId], references: [id], onDelete: Cascade)
  createdById         String
  // Preenchido automaticamente com createdById na criação; pode ser
  // reatribuído depois. Sem @relation obrigatória no schema porque, assim
  // como createdById, é só um scalar id (ver comentário em
  // app/api/bridges/route.ts sobre por que createdById não tem FK formal) —
  // poUserId/uxUserId TÊM relação formal porque precisamos resolver
  // avatar/nome via `include` direto no editor (ver BRIDGE_WITH_PLANET_INCLUDE).
  poUserId              String?
  poUser                User?       @relation("BridgePO", fields: [poUserId], references: [id])
  uxUserId              String?
  uxUser                User?       @relation("BridgeUX", fields: [uxUserId], references: [id])
  // GERANDO_BDD | AGUARDANDO_APROVACAO_BDD | GERANDO_WIREFRAME |
  // AGUARDANDO_APROVACAO_WIREFRAME_PO | AGUARDANDO_APROVACAO_UX | ERRO_GERACAO
  status              String
  // Material de entrada — arquivo OU texto colado (nunca os dois).
  rawMaterialText     String?
  rawMaterialFileUrl  String?
  generatedBddPbi     String?
  // Primeira versão gerada do BDD/PBI (antes de qualquer rejeição) — mantida
  // à parte de generatedBddPbi (que é sobrescrito a cada regeração) pra
  // alimentar o par inicial/final do PlanetExample quando o BDD é aprovado.
  firstGeneratedBddPbi String?
  bddApprovedAt         DateTime?
  // Estrutura do Wireframe: { frameWidth, frameHeight, blocks: [{ id, label,
  // zone, row, order, widthHint, heightHint, x, y, width, height }] } — ver
  // lib/bridges/wireframeLayout.ts. zone/row/order/widthHint/heightHint vêm
  // congelados da geração da IA (metadado, usado no aprendizado); x/y/width/
  // height são a posição/tamanho livres de verdade, editáveis no canvas.
  wireframeData             Json?
  wireframeAttemptCount     Int      @default(0)
  lastWireframeRejectionComment String?
  // Mensagem de erro da IA quando status=ERRO_GERACAO (não faz sentido
  // reaproveitar lastRejectionComment, que é do PO, não da falha técnica).
  errorMessage          String?
  attemptCount          Int      @default(0)
  lastRejectionComment  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  // Anotações à mão livre (ferramenta Caneta) e comentários de colaboração
  // (ferramenta Comentário) — Wireframe-1b. Entidades à parte dos blocos
  // estruturados (wireframeData.blocks): não são componentes de interface,
  // não entram no agrupamento/Camadas/undo-redo dos blocos.
  annotations           WireframeAnnotation[]
  comments              WireframeComment[]
}

// Traço de desenho livre (ferramenta Caneta, Wireframe-1b) — pontos
// congelados em formato de path SVG ("M x y L x y L x y ...") no momento do
// desenho. Pode ser movido (offset de todos os pontos) e apagado, mas não
// editado ponto a ponto nesta fase.
model WireframeAnnotation {
  id        String   @id @default(cuid())
  bridgeId  String
  bridge    Bridge   @relation(fields: [bridgeId], references: [id], onDelete: Cascade)
  pathData  String
  color     String   @default("#94a3b8")
  createdAt DateTime @default(now())
}

// Pino de comentário de colaboração (ferramenta Comentário, Wireframe-1b),
// posicionado em coordenadas absolutas do frame. O texto inicial fica direto
// aqui (não como a 1ª reply) pra simplificar — WireframeCommentReply só
// guarda as respostas subsequentes da thread. authorId é um scalar sem
// @relation formal (mesmo padrão de Bridge.createdById — ver comentário lá).
model WireframeComment {
  id        String                  @id @default(cuid())
  bridgeId  String
  bridge    Bridge                  @relation(fields: [bridgeId], references: [id], onDelete: Cascade)
  x         Float
  y         Float
  authorId  String
  text      String
  resolved  Boolean                 @default(false)
  createdAt DateTime                @default(now())
  replies   WireframeCommentReply[]
}

model WireframeCommentReply {
  id        String           @id @default(cuid())
  commentId String
  comment   WireframeComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  authorId  String
  text      String
  createdAt DateTime         @default(now())
}

model ContextNode {
  id           String          @id @default(cuid())
  type         ContextNodeType
  name         String
  parentId     String?
  parent       ContextNode?    @relation("ContextTree", fields: [parentId], references: [id])
  children     ContextNode[]   @relation("ContextTree")
  patterns     MemoryPattern[]
  // Usuários com esta Galáxia selecionada no momento, e vínculos de acesso
  // (N:N) — ver User.currentGalaxyId / UserGalaxyAccess acima.
  currentForUsers  User[]             @relation("UserCurrentGalaxy")
  galaxyAccess     UserGalaxyAccess[]
  // Bridges criados a partir deste Planeta (Bridge-1).
  bridges          Bridge[]
  // Só preenchido quando type=PLANETA.
  planetTypeId String?
  planetType   PlanetType?     @relation(fields: [planetTypeId], references: [id])
  // Exemplos de treino anexados diretamente a este nó (só faz sentido para
  // PLANETA). Vinculado ao nó, não ao PlanetType — cruzar exemplos entre
  // Planetas do mesmo tipo é trabalho da Fase N6.
  examples     PlanetExample[]
  // Vínculos com fontes de Design System (só faz sentido para GALAXIA) —
  // Fase N5, N:N via DesignSystemGalaxyLink (uma fonte pode servir várias
  // Galáxias, uma Galáxia pode ter várias fontes).
  designSystemLinks DesignSystemGalaxyLink[]
}

// Catálogo global de tipos de Planeta (reutilizável entre Universos/Galáxias
// diferentes) — ex: "Listagem", "Formulário", "Dashboard".
model PlanetType {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String?
  createdAt    DateTime      @default(now())
  contextNodes ContextNode[]
}

// Exemplos de treino de um Planeta específico (transcrição bruta, BDD/PBI
// final, wireframe de referência) — Fase N4. Vinculados ao ContextNode (o
// Planeta), não ao PlanetType: cada Planeta acumula os próprios exemplos: já
// que todo Planeta tem um planetTypeId, dá pra cruzar exemplos entre
// Planetas do mesmo tipo depois (Fase N6) sem precisar duplicar o vínculo
// aqui.
model PlanetExample {
  id            String      @id @default(cuid())
  contextNodeId String
  // onDelete: Cascade — exemplo é um anexo do Planeta, não uma entidade
  // independente; se o Planeta for excluído (já sem filhos na árvore, regra
  // aplicada em app/api/nova/nodes/[id]/route.ts), os exemplos vão junto. Os
  // arquivos no Storage são removidos manualmente antes, na mesma rota.
  contextNode   ContextNode @relation(fields: [contextNodeId], references: [id], onDelete: Cascade)
  kind          String // "RAW_TRANSCRIPT" | "FINAL_BDD_PBI" | "WIREFRAME_REFERENCE"
  // Usados por RAW_TRANSCRIPT e WIREFRAME_REFERENCE. Para FINAL_BDD_PBI,
  // usar o par inicial/final abaixo em vez destes (confirmado sem dados
  // reais de FINAL_BDD_PBI no banco antes desta mudança).
  fileUrl       String?
  textContent   String?
  // Só para kind=FINAL_BDD_PBI: par inicial (rascunho/versão extraída da
  // transcrição) e final (aprovada), pra o sistema aprender a transformação.
  // Cada lado é independentemente opcional — arquivo OU texto colado, dos
  // dois lados, de só um, ou de nenhum.
  initialTextContent String?
  initialFileUrl     String?
  finalTextContent   String?
  finalFileUrl       String?
  // Só para kind=WIREFRAME_REFERENCE: tipo livre (combobox com sugestões
  // pré-definidas + criação de novo valor na hora — sem tabela de catálogo
  // separada, as sugestões vêm dos valores distintos já usados aqui).
  referenceType String?
  uploadedById  String?
  createdAt     DateTime    @default(now())
}

// Fonte de Design System do Figma (Fase N5) — catálogo global, gerenciado
// por ADMIN (criar/sincronizar/remover). Vira visível pra uma Galáxia só
// quando alguém cria um DesignSystemGalaxyLink pra ela (N:N: uma fonte pode
// servir várias Galáxias, uma Galáxia pode usar várias fontes). Propósito é
// identificar QUAIS componentes existem (referência estrutural pra
// wireframes simples), não capturar protótipos de alta fidelidade.
model DesignSystemSource {
  id           String                   @id @default(cuid())
  name         String
  figmaFileKey String
  figmaUrl     String
  lastSyncedAt DateTime?
  addedById    String?
  createdAt    DateTime                 @default(now())
  components   DesignSystemComponent[]
  galaxyLinks  DesignSystemGalaxyLink[]
}

// Tabela de junção N:N entre DesignSystemSource e ContextNode (tipo
// GALAXIA). Criar/remover um vínculo é a mesma permissão de
// criar/editar Estrela/Planeta naquela Galáxia (ADMIN em qualquer uma,
// usuário comum só na própria) — ver lib/nova/permissions.ts::canManageGalaxy.
model DesignSystemGalaxyLink {
  id         String             @id @default(cuid())
  sourceId   String
  source     DesignSystemSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  galaxyId   String
  galaxy     ContextNode        @relation(fields: [galaxyId], references: [id], onDelete: Cascade)
  linkedById String?
  createdAt  DateTime           @default(now())

  @@unique([sourceId, galaxyId])
}

// Componentes do design system (import do Figma), sempre vinculados a uma
// DesignSystemSource — que por sua vez pertence a uma Galáxia.
model DesignSystemComponent {
  id                String             @id @default(cuid())
  name              String
  figmaComponentKey String?            @unique
  thumbnailUrl      String?
  description       String?
  metadata          Json?
  createdAt         DateTime           @default(now())
  sourceId          String
  // onDelete: Cascade — componente é um item importado da fonte, não uma
  // entidade independente; remover a fonte remove os componentes junto.
  source            DesignSystemSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model Transcription {
  id           String              @id @default(cuid())
  squadId      String
  fileUrl      String
  rawText      String?
  status       TranscriptionStatus @default(UPLOADED)
  createdAt    DateTime            @default(now())
  extraction   Extraction?
  artifacts    Artifact[]
  goalModeRuns GoalModeRun[]
}

model Extraction {
  id              String        @id @default(cuid())
  transcriptionId String        @unique
  transcription   Transcription @relation(fields: [transcriptionId], references: [id])
  entitiesJson    Json
  rulesJson       Json
  intent          String
  contextNodeId   String?
  modelUsed       String
  createdAt       DateTime      @default(now())
}

model Artifact {
  id              String        @id @default(cuid())
  transcriptionId String
  transcription   Transcription @relation(fields: [transcriptionId], references: [id])
  type            ArtifactType
  contentMd       String
  version         Int           @default(1)
  status          String // DRAFT | PENDING_PO | APPROVED | REJECTED
  createdByAi     Boolean       @default(true)
  approvedById    String?
  approvedAt      DateTime?
  wireframes      Wireframe[]
  createdAt       DateTime      @default(now())
}

model Wireframe {
  id           String    @id @default(cuid())
  artifactId   String
  artifact     Artifact  @relation(fields: [artifactId], references: [id])
  htmlContent  String
  version      Int       @default(1)
  status       String // DRAFT | PENDING_UX | APPROVED | REJECTED
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
}

model ApprovalLog {
  id             String           @id @default(cuid())
  targetType     String // ARTIFACT | WIREFRAME
  targetId       String
  approverId     String
  decision       ApprovalDecision
  comment        String?
  correctionDiff String?
  createdAt      DateTime         @default(now())
}

model MemoryPattern {
  id               String      @id @default(cuid())
  contextNodeId    String
  contextNode      ContextNode @relation(fields: [contextNodeId], references: [id])
  patternType      String
  patternData      Json
  confidence       Float       @default(0.5)
  sourceApprovalId String?
  createdAt        DateTime    @default(now())
}

model EngineConfig {
  id          String   @id @default(cuid())
  provider    String   @unique // gemini | openai | claude
  apiKeyEnc   String?
  apiKeyLast4 String?
  enabled     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model GoalModeRun {
  id              String        @id @default(cuid())
  transcriptionId String
  transcription   Transcription @relation(fields: [transcriptionId], references: [id])
  status          String
  startedById     String
  startedAt       DateTime      @default(now())
  completedAt     DateTime?
  logJson         Json?
}

model Notification {
  id                String   @id @default(cuid())
  recipientId       String
  type              String
  relatedEntityType String
  relatedEntityId   String
  channel           String   @default("EMAIL")
  sentAt            DateTime @default(now())
}
